# Copy to config.local.env and fill in your ThaID registration values, then run
#   go run ./cmd/webapp
# with no flags. config.local.env is git-ignored so secrets stay out of source.

# --- ThaID (DOPA) production ---
THAID_ISSUER=https://imauth.bora.dopa.go.th
THAID_CLIENT_ID=<client_id ที่ได้รับ>
THAID_CLIENT_SECRET=<client_secret ที่ได้รับ>
THAID_REDIRECT_URL=<redirect_uri ที่ลงทะเบียน ตรงกันทุกตัวอักษร>
THAID_SCOPES=openid pid title given_name family_name gender
THAID_USE_PKCE=true
THAID_ALLOW_MISSING_NONCE=false
# ถ้า redirect_uri อยู่คนละ host กับเครื่องที่รัน (เช่น intranet) ให้ใช้ paste mode
THAID_PASTE_CALLBACK=true
LISTEN=127.0.0.1:8081

# --- Local Mock ThaID instead: set these (or delete/rename config.local.env) ---
# THAID_ISSUER=http://localhost:9000
# THAID_CLIENT_ID=demo-web
# THAID_CLIENT_SECRET=demo-secret
# THAID_REDIRECT_URL=http://localhost:8081/callback
# THAID_PASTE_CALLBACK=false
